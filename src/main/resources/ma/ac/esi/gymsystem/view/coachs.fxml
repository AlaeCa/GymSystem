<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" stylesheets="@../style.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.ac.esi.gymsystem.controller.CoachController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Gestion des Coachs" styleClass="titre-page"/>

    <GridPane hgap="10" vgap="10" styleClass="formulaire">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

        <Label text="Nom *"         GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="champNom" promptText="Nom"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Prénom *"         GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="champPrenom" promptText="Prénom"
                   GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Email *"          GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="champEmail"  promptText="email@exemple.com"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="labelValidationEmail" text=""
               GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="2"/>

        <Label text="Téléphone"            GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="champTelephone"  promptText="0612345678"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label fx:id="labelValidationTel" text=""
               GridPane.rowIndex="2" GridPane.columnIndex="2" GridPane.columnSpan="2"/>

        <Label text="Spécialité"           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="champSpecialite" promptText="Ex: Yoga, Musculation..."
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Ajouter"    onAction="#ajouterCoach"   styleClass="btn-vert"/>
        <Button text="Modifier"   onAction="#modifierCoach"  styleClass="btn-bleu"/>
        <Button text="Supprimer"  onAction="#supprimerCoach" styleClass="btn-rouge"/>
        <Button text="Actualiser" onAction="#chargerCoachs"  styleClass="btn-gris"/>
        <Button text="Vider"      onAction="#viderChamps"    styleClass="btn-gris"/>
    </HBox>

    <Label fx:id="labelStatut" text="Prêt." styleClass="label-statut"/>

    <TableView fx:id="tableCoachs" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"         text="ID"          prefWidth="50"/>
            <TableColumn fx:id="colNom"        text="Nom"         prefWidth="120"/>
            <TableColumn fx:id="colPrenom"     text="Prénom"      prefWidth="120"/>
            <TableColumn fx:id="colEmail"      text="Email"       prefWidth="200"/>
            <TableColumn fx:id="colTelephone"  text="Téléphone"   prefWidth="130"/>
            <TableColumn fx:id="colSpecialite" text="Spécialité"  prefWidth="150"/>
        </columns>
    </TableView>
</VBox>